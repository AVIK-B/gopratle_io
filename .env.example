# Copy to .env and fill in to go from demo mode to live mode.
# Nothing here is required to run `python demo.py` — it works with none of these set.

# --- Deterministic workflow ---
DEMO_MODE=0                      # known demo fixtures only when enabled

# --- Enrichment (src/enrichment.py) ---
PEOPLE_API_KEY=                  # Apollo/Hunter/proxycurl-style provider — stage 3 of the waterfall
HUNTER_API_KEY=                  # optional person-name + company-domain email finder
# Optional search APIs; public DuckDuckGo HTML search is the no-key fallback.
# SERPAPI_KEY=
# TAVILY_API_KEY=

# --- Sheet backend (src/store.py) — leave both blank to use the local CSV ---
GOOGLE_SHEETS_CREDS=             # path to a Google service-account json
# Preferred when service-account key creation is blocked by organization policy:
GOOGLE_OAUTH_CLIENT_SECRETS=    # path to downloaded OAuth Desktop client JSON
GOOGLE_SHEETS_TOKEN=data/google_authorized_user.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_LEADS_TAB=Leads     # falls back to the only tab (often Sheet1)
GOOGLE_SHEET_RUNS_TAB=Runs
GOOGLE_SHEETS_TIMEOUT_SECONDS=15
SHEET_POLL_SECONDS=5
SERVER_HOST=127.0.0.1
SERVER_PORT=8787

# --- Public evidence crawler ---
CRAWL_MODE=off                   # set to live only after reviewing network/rate limits
CRAWL_MAX_PAGES=5                # hard cap; pages are fetched concurrently
RETRIEVAL_TIMEOUT_SECONDS=5      # per-request timeout; lower this for faster failure
SEARCH_MODE=off                  # set to live to use Tavily or SerpAPI snippets
RESEARCH_GRAPH=langgraph         # parallel website/search evidence agents
TAVILY_API_KEY=                  # preferred search provider
SERPAPI_KEY=                     # alternative search provider

# --- Outreach (src/outreach.py) ---
LIVE_SEND=0                      # set to 1 only after wiring a real sandbox credential
TELEGRAM_BOT_TOKEN=               # for telegram_bot.py / live Telegram sends
